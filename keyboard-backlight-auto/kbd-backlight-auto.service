[Unit]
Description=Ambient-light driven keyboard backlight
Documentation=https://github.com/burakgon/asus-expertbook-linux
ConditionPathExists=/sys/class/leds/asus::kbd_backlight/brightness
# systemd-backlight restores a saved level at boot. On this machine the LED's
# read-back is broken so it always saves (and restores) 0 - run after it so the
# curve gets the last word.
After=systemd-backlight@leds:asus::kbd_backlight.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/kbd-backlight-auto
Restart=on-failure
RestartSec=2

# Needs: read /sys/bus/iio + /proc/acpi, read /dev/input/event*, write the LED.
NoNewPrivileges=yes
# Not ProtectHome=: every mode of it also covers /run/user, where brightnessctl
# keeps the per-session saved level that sync_saved corrects - "yes" hides it,
# "read-only" and "tmpfs" leave it unwritable, and a BindPaths= on the same
# path inherits the read-only flag (systemd's drop_duplicates propagates it).
# This is what ProtectHome=tmpfs expands to, minus its /run/user entry.
TemporaryFileSystem=/home:ro /root:ro
# full, not strict: strict remounts the whole tree read-only, /run included.
# full keeps /usr, /boot, /efi and /etc read-only and leaves /run writable.
ProtectSystem=full
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Root with no capabilities cannot enter /run/user/<uid> (mode 700), where
# brightnessctl keeps the per-session saved level sync_saved corrects; the
# file itself is world-writable, so traversal is the only right needed.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
IPAddressDeny=any
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
